<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude database files from cloud backup -->
        <exclude domain="database" />
        <!-- Include user preferences -->
        <include domain="sharedpref" path="music_preferences.xml"/>
    </cloud-backup>
    
    <device-transfer>
        <!-- Include all user data for device transfer -->
        <include domain="sharedpref" />
        <include domain="database" />
    </device-transfer>
</data-extraction-rules>